<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SwingIQ v2</title>
<style>
  body { font-family: system-ui; max-width: 430px; margin: 0 auto; padding: 20px; background: #0a0a0a; color: #fff; }
  h1 span { color: #22c55e; }
  .upload-area { border: 2px dashed #333; border-radius: 12px; padding: 40px; text-align: center; margin: 20px 0; }
  button { background: #22c55e; color: #000; border: none; padding: 14px 28px; border-radius: 8px; font-size: 16px; font-weight: 700; cursor: pointer; width: 100%; }
  .status { margin: 10px 0; font-size: 14px; color: #888; }
  /* TODO: Full UI from v1 will be migrated here */
</style>
</head>
<body>
  <h1>Swing<span>IQ</span> v2</h1>
  <p style="color:#888;font-size:13px">Backend-powered analysis. Consistent across all devices.</p>
  
  <div class="upload-area">
    <p>Upload swing video</p>
    <input type="file" id="videoInput" accept="video/mp4,video/quicktime,.mov,.mp4">
  </div>
  
  <select id="club" style="width:100%;padding:10px;margin:5px 0;background:#1a1a1a;color:#fff;border:1px solid #333;border-radius:6px">
    <option value="iron">Iron</option>
    <option value="driver">Driver</option>
  </select>
  
  <select id="view" style="width:100%;padding:10px;margin:5px 0;background:#1a1a1a;color:#fff;border:1px solid #333;border-radius:6px">
    <option value="dtl">Down The Line</option>
    <option value="face-on">Face On</option>
  </select>
  
  <button onclick="analyze()">🎯 Analyze Swing</button>
  <div class="status" id="status"></div>
  <pre id="result" style="font-size:11px;background:#111;padding:10px;border-radius:8px;overflow-x:auto;display:none"></pre>

<script>
async function analyze() {
  const file = document.getElementById('videoInput').files[0];
  if (!file) return alert('Select a video first');
  
  const status = document.getElementById('status');
  const resultEl = document.getElementById('result');
  status.textContent = 'Uploading & analyzing...';
  resultEl.style.display = 'none';
  
  const formData = new FormData();
  formData.append('video', file);
  formData.append('club', document.getElementById('club').value);
  formData.append('view', document.getElementById('view').value);
  
  try {
    const res = await fetch('/api/analyze', { method: 'POST', body: formData });
    const data = await res.json();
    
    if (data.error) {
      status.textContent = 'Error: ' + data.error;
      return;
    }
    
    status.textContent = `Done in ${data.debug?.processingTime}s — Score: ${data.coaching?.overall_score}/100`;
    resultEl.textContent = JSON.stringify(data, null, 2);
    resultEl.style.display = 'block';
    
  } catch(e) {
    status.textContent = 'Error: ' + e.message;
  }
}
</script>
</body>
</html>
